<Project>
  <!-- Keep restore/intermediate output inside the already-ignored host/lib tree. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>lib/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ClassDesk</AssemblyName>
    <RootNamespace>ClassDesk</RootNamespace>
    <Title>교실데스크 · ClassDesk</Title>
    <Product>ClassDesk</Product>
    <Description>Korean school wallpaper host; independent GPL-3.0 derivative of Deskland</Description>
    <Copyright>Copyright 2026 Deskland authors and ClassDesk contributors; GPL-3.0</Copyright>
    <Version>0.3.0</Version>
    <ApplicationIcon>ClassDesk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>5</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DesktopHost.cs" />
    <Compile Include="IconIdentityTracker.cs" />
    <Compile Include="GroupState.cs" />
    <Compile Include="DesktopGroupEditor.cs" />
    <Compile Include="Themes.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <!-- Explicit references avoid the Windows-only WPF/build targets in this SDK. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)/lib/net462/Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(PkgMicrosoft_Web_WebView2)/lib/net462/Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ClassDesk.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt" Link="WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
